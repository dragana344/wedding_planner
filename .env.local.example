# Copy to .env.local and fill in. Placeholders only - never commit real values.
# Full list, environments and rotation: docs/production/SECRETS.md

# Supabase project you develop against (local: `npx supabase status`).
# Never production keys here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# Server-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-or-service-role-key

# Public origin for links in guest emails (invitations, reminders) and QR codes. Optional.
# NEXT_PUBLIC_SITE_URL=https://kadesum.mk
# Optional. Days after the event that guests' album photos and greetings are
# kept before deletion (docs/production/RETENTION.md). Empty = never deleted.
# MEDIA_RETENTION_DAYS=
