{
  "name": "wedding-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:db": "node scripts/write-test-env.mjs && vitest run -c vitest.db.config.ts",
    "test:e2e": "playwright test",
    "test:unit:coverage": "vitest run --coverage",
    "test:db:coverage": "node scripts/write-test-env.mjs && vitest run -c vitest.db.config.ts --coverage",
    "bundle:report": "node scripts/bundle-report.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:check": "storybook build --quiet && node scripts/storybook-check.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/nextjs-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^24.1.3",
    "pg": "^8.23.1",
    "postcss": "^8",
    "storybook": "^10.6.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
